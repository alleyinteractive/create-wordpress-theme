{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "useRootPaddingAwareAlignments": true,
    "appearanceTools": false,
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [],
      "palette" : [
        {
          "slug": "primary",
          "color": "#b34534",
          "name": "Primary"
        },
        {
          "slug": "black",
          "color": "#000000",
          "name": "Black"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        }
      ]
    },
    "custom": {
      "spacing": {
        "blockGap": "var:preset|spacing|60, 2.25rem",
        "siteEdge": "clamp(1rem, 5vw, 2rem)"
      }
    },
    "layout": {
      "contentSize": "48rem",
      "wideSize": "80rem",
      "allowCustomContentAndWideSize": false
    },
    "shadow": {
      "defaultPresets": false,
      "presets": []
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "customSpacingSize": false
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "dropCap": false,
      "fontStyle": false,
      "fontWeight": false,
      "letterSpacing": false,
      "lineHeight": false,
      "textDecoration": false,
      "textTransform": false,
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.75rem",
          "name": "Extra Small"
        },
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "md",
          "size": "1rem",
          "name": "Medium"
        },
        {
          "slug": "lg",
          "size": "1.25rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "1.5rem",
          "name": "Extra Large"
        },
        {
          "slug": "2xl",
          "size": "2rem",
          "name": "2x Large"
        },
        {
          "slug": "3xl",
          "size": "2.5rem",
          "name": "3x Large"
        },
        {
          "slug": "4xl",
          "size": "3rem",
          "name": "4x Large"
        }
      ],
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, avenir next, avenir, segoe ui, helvetica neue, helvetica, Cantarell, Ubuntu, roboto, noto, arial, sans-serif",
          "slug": "system-sans-serif",
          "name": "System Sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "text": "var:preset|color|black"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        "typography": {
          "textDecoration": "underline"
        }
      }
    },
    "spacing": {
      "blockGap": "var:custom|spacing|block-gap, 2.25rem",
      "padding": {
        "top": "0",
        "right": "var:custom|spacing|site-edge, 5vw",
        "bottom": "0",
        "left": "var:custom|spacing|site-edge, 5vw"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system-sans-serif",
      "fontSize": "var:preset|font-size|md",
      "fontWeight": "400",
      "lineHeight": "1.5"
    }
  },
  "customTemplates": [],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}