{
  "name": "alleyinteractive/create-wordpress-theme",
  "description": "A skeleton WordPress theme",
  "type": "wordpress-theme",
  "keywords": [
    "alleyinteractive",
    "create-wordpress-theme"
  ],
  "homepage": "https://github.com/alleyinteractive/create-wordpress-theme",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Alley",
      "email": "info@alley.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "alleyinteractive/composer-wordpress-autoloader": "^1.1",
    "alleyinteractive/wp-type-extensions": "^3.0"
  },
  "require-dev": {
    "alleyinteractive/alley-coding-standards": "^2.1",
    "mantle-framework/testkit": "^1.5",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "config": {
    "allow-plugins": {
      "alleyinteractive/composer-wordpress-autoloader": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "autoload-dev": {
    "psr-4": {
      "Create_WordPress_Theme\\Tests\\": "tests"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "phpcbf": "phpcbf .",
    "phpcs": "phpcs .",
    "phpstan": "phpstan --memory-limit=512M",
    "lint": [
      "@phpcs",
      "@phpstan"
    ],
    "lint:fix": [
      "@rector:fix",
      "@phpcbf"
    ],
    "phpunit": "phpunit",
    "release": "npx @alleyinteractive/create-release@latest",
    "test": [
      "@phpcs",
      "@phpstan",
      "@phpunit"
    ]
  }
}
